<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/static/cache/favicon_50x50.webp" />
    <link href="/static/style.css" rel="stylesheet"/>
    <link href="/static/style2.css" rel="stylesheet"/>
    <title>Gardener: The Mini Web Framework</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans">

    <div class='hidden' id='fileName'><%=fileName%></div>
    <div class='loader w-screen h-screen bg-white fixed z-2'> </div>
    <div class='notification'></div>

    <div id='main' class="min-h-screen bg-slate-100 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-md mx-auto bg-white rounded-xl shadow-md overflow-hidden md:max-w-2xl p-8">
        <h1 class="text-3xl font-bold text-slate-900 mb-8 border-b pb-4">My Tasks</h1>
        
        <div class="flex gap-2 mb-8">
          <input type="text" id="todo-input" placeholder="What needs to be done?" class="flex-1 bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block p-2.5" />
          <button id="add-todo-btn" class="text-white bg-green-600 hover:bg-green-700 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition">Add Task</button>
        </div>

        <div id="todo-list" class="space-y-3">
          <!-- Todos will be rendered here -->
          <div class="flex items-center justify-center p-8 text-slate-400">
            <p>Loading your tasks...</p>
          </div>
        </div>
      </div>
    </div>

  </body>
  <% if (process.env.NODE_ENV === 'production') { %>
    <script type='module' src='/static/bundle/bundle.<%=fileName%>.js'></script>
  <% } else { %>
<script src="/static/pages/pages.todos.js" type='module'></script>
    <script type='module' src='/static/global.js'></script>

  <% } %>
</html>
